<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>PREPARATION_TESTS;BOOTSTRAP_TESTS</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TrustedPreparation.cs" Link="TrustedPreparation.cs" />
    <Compile Include="../StagedPayload.cs" Link="StagedPayload.cs" />
    <Compile Include="../Bootstrap.cs" Link="Bootstrap.cs" />
    <Compile Include="../WindowsPreflight.cs" Link="WindowsPreflight.cs" />
    <Compile Include="$(GeneratedPayload)" Link="ApprovedPayload.g.cs" />
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="Trojaino.Setup.Payload" />
  </ItemGroup>
</Project>
