<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>BOOTSTRAP_TESTS</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Bootstrap.cs" Link="Bootstrap.cs" />
    <Compile Include="../WindowsPreflight.cs" Link="WindowsPreflight.cs" />
    <Compile Include="../StagedPayload.cs" Link="StagedPayload.cs" />
    <Compile Include="$(GeneratedPayload)" Link="ApprovedPayload.g.cs" />
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="Trojaino.Setup.Payload" />
  </ItemGroup>
  <Target Name="RequireApprovedInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(GeneratedPayload)' == '' or '$(PayloadArchive)' == ''" Text="Explicit developer-approved generated source and payload archive are required." />
  </Target>
</Project>
