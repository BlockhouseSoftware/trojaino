<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DefineConstants>$(DefineConstants);SETUP_PLAN_TESTS;SETUP_DISCOVERY_TESTS;ACCOUNT_TRANSACTION_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Bootstrap.cs" /><Compile Include="../WindowsPreflight.cs" />
    <Compile Include="../SetupLocations.cs" /><Compile Include="../DefaultSetupDiscovery.cs" />
    <Compile Include="../DefaultSetupPlan.cs" /><Compile Include="../SharedParents.cs" />
    <Compile Include="../SetupController.cs" /><Compile Include="../StagedPayload.cs" />
    <Compile Include="../TrustedPreparation.cs" /><Compile Include="../ReceiptCodec.cs" />
    <Compile Include="../StateStore.cs" /><Compile Include="../PairState.cs" /><Compile Include="../DefaultSetup.cs" />
    <Compile Include="../AccountPreferenceDocument.cs" />
    <Compile Include="../AccountPreferenceTransaction.cs" Condition="Exists('../AccountPreferenceTransaction.cs')" />
    <Compile Include="$(GeneratedPayload)" Link="ApprovedPayload.g.cs" />
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="Trojaino.Setup.Payload" />
  </ItemGroup>
</Project>
