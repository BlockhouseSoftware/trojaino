<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SetupController.cs" Link="SetupController.cs" />
    <Compile Include="../SetupLocations.cs" Link="SetupLocations.cs" />
    <Compile Include="../PairState.cs" Link="PairState.cs" />
    <Compile Include="../StateStore.cs" Link="StateStore.cs" />
    <Compile Include="../ReceiptCodec.cs" Link="ReceiptCodec.cs" />
    <Compile Include="../Bootstrap.cs" Link="Bootstrap.cs" />
    <Compile Include="../WindowsPreflight.cs" Link="WindowsPreflight.cs" />
    <Compile Include="../StagedPayload.cs" Link="StagedPayload.cs" />
    <Compile Include="../TrustedPreparation.cs" Link="TrustedPreparation.cs" />
    <Compile Include="$(GeneratedPayload)" Link="ApprovedPayload.g.cs" />
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="Trojaino.Setup.Payload" />
  </ItemGroup>
  <Target Name="RequireApprovedInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(GeneratedPayload)' == '' or '$(PayloadArchive)' == ''" Text="Explicit approved inputs required." />
  </Target>
</Project>
