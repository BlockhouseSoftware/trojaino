<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Bootstrap.cs" /><Compile Include="../WindowsPreflight.cs" />
    <Compile Include="../SetupLocations.cs" /><Compile Include="../DefaultSetupPlan.cs" />
    <Compile Include="../ReceiptCodec.cs" /><Compile Include="../StateStore.cs" /><Compile Include="../PairState.cs" />
    <Compile Include="../DefaultSetupDiscovery.cs" />
    <Compile Include="$(GeneratedPayload)" Link="ApprovedPayload.g.cs" />
    <Compile Include="../StagedPayload.cs" /><Compile Include="../TrustedPreparation.cs" />
    <EmbeddedResource Include="$(PayloadArchive)" LogicalName="Trojaino.Setup.Payload" />
  </ItemGroup>
</Project>
