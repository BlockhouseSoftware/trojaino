{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/scripts/launch.sh\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/scripts/launch.sh\" pre-tool-use",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
