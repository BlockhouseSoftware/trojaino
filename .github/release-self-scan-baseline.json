{
  "findings": [
    {
      "id": "CI_SECRET_REFERENCE",
      "severity": "medium",
      "file": ".github/workflows/install-gate.yml",
      "line": 114,
      "fingerprint": "c6d6a7105cbbc182f615bef4",
      "review": "The live install-gate job passes ANTHROPIC_API_KEY to Claude Code so a real session can exercise the plugin. GitHub withholds repository secrets from pull requests opened from forks, and the job is skipped when the key is absent."
    },
    {
      "id": "MCP_CREDENTIAL_ACCESS",
      "severity": "critical",
      "file": "plugins/trojaino/scripts/preflight.py",
      "line": 8,
      "fingerprint": "4faae95fce69d38de29faad8",
      "review": "The sealed entry contains the scanner's credential-detection rules as data; it exposes no credential tool to Claude."
    },
    {
      "id": "MCP_FILESYSTEM_TOOL",
      "severity": "medium",
      "file": "plugins/trojaino/scripts/preflight.py",
      "line": 6,
      "fingerprint": "ac1eb14d1952e0ebb596c365",
      "review": "The install gate reads the package it downloaded, or the local folder named in an install command, solely to scan it; it is not a general agent filesystem tool."
    },
    {
      "id": "MCP_OUTBOUND_ENDPOINT",
      "severity": "medium",
      "file": "plugins/trojaino/scripts/preflight.py",
      "line": 4,
      "fingerprint": "fe05d060991e2a8b725c988d",
      "review": "The flagged URL is the public Python recovery documentation printed on startup failure. Printing the link makes no network request. Registry fetching remains restricted to the explicit package checks."
    },
    {
      "id": "MCP_SHELL_TOOL",
      "severity": "high",
      "file": "plugins/trojaino/scripts/preflight.py",
      "line": 8,
      "fingerprint": "d51ee31e1f3e482e26ecf182",
      "review": "The sealed payload includes shell-detection rules as data. Doctor invokes only the installed hook entry and Claude version query; it scans its synthetic fixture without executing or installing it. The gate never executes candidate package code."
    },
    {
      "id": "PY_EVAL_EXEC",
      "severity": "high",
      "file": "plugins/trojaino/scripts/preflight.py",
      "line": 10,
      "fingerprint": "8fbe9cac4ed231c37f707d6f",
      "review": "The entry executes only the versioned sealed capsule bootstrap, after refusing to run without Python 3.11+ isolation flags."
    },
    {
      "id": "PY_EVAL_EXEC",
      "severity": "high",
      "file": "trojaino/claude/sealed_runtime_bootstrap.py",
      "line": 46,
      "fingerprint": "fc6f896cc7277c70f0b77d49",
      "review": "The bootstrap executes only hash-bound modules from the reviewed capsule, never package or project code."
    }
  ],
